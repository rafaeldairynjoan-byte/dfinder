{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "isolatedModules": true
  },
  "include": [
    "./**/*.ts",
    "../server/**/*.ts",
    "../src/types/**/*.ts"
  ]
}
